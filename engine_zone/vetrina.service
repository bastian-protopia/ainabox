[Unit]
Description=Vetrina (AINABOX)
After=network.target

[Service]
User=svc_vetrina
WorkingDirectory=$AIBOX/vetrina_zone
ExecStart=$AIBOX/vetrina_zone/venv/bin/python $AIBOX/vetrina_zone/main.py
Restart=always
RestartSec=5
StandardOutput=append:$AIBOX/vetrina_zone/vetrina.log
StandardError=append:$AIBOX/vetrina_zone/vetrina.log

[Install]
WantedBy=multi-user.target
