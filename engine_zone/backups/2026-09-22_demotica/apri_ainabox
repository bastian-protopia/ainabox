#!/usr/bin/env bash
echo "═══════════════════════════════════════════"
echo "  AINABOX — BOOTSTRAP + AVVIO (v2)"
echo "═══════════════════════════════════════════"

USERS=(
    "svc_ollama:4821:4800:/home/svc_ollama:/usr/sbin/nologin"
    "svc_owu:9374:4800:/home/svc_owu:/usr/sbin/nologin"
    "svc_comfy:7210:4800:/home/svc_comfy:/usr/sbin/nologin"
    "svc_speaches:995:4800:/home/svc_speaches:/bin/sh"
    "svc_updater:5510:5500:/home/svc_updater:/usr/sbin/nologin"
    "svc_manutentore:997:5501:/home/svc_manutentore:/usr/sbin/nologin"
)
GRP_DEF=("ai_services:4800" "engine_mgr:5500" "manutentore:5501" "ainabox:4899")
T7_BIN="/mnt/Data/engine_zone/bin"
T7_SUDOERS="/mnt/Data/engine_zone/sudoers.d"
RUNTIME="/mnt/Data/engine_zone/runtime"
CURRENT_USER="${SUDO_USER:-$(whoami)}"

echo ""
echo "── FASE 0: Verifiche ──"
if command -v nvidia-smi &>/dev/null; then
    GPU_NAME=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)
    GPU_MEM=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | head -1)
    echo "  GPU: ${GPU_NAME} (${GPU_MEM} MB)"
else
    echo "  [!] GPU NVIDIA non rilevata. CPU-only."
fi
RAM_TOTAL=$(free -g 2>/dev/null | awk '/^Mem:/{print $2}')
echo "  RAM: ${RAM_TOTAL} GB"

echo ""
echo "── FASE 1: Bootstrap host ──"
for entry in "${GRP_DEF[@]}"; do
    gname="${entry%%:*}"
    ggid="${entry##*:}"
    if getent group "$gname" &>/dev/null; then
        echo "  [ok] gruppo $gname (già esiste)"
    else
        groupadd --system --gid "$ggid" "$gname" 2>/dev/null \
            && echo "  [ok] gruppo $gname creato" \
            || echo "  [!] gruppo $gname fallimento"
    fi
done

if id -nG "$CURRENT_USER" 2>/dev/null | grep -qw "ainabox"; then
    echo "  [ok] $CURRENT_USER già in ainabox"
else
    usermod -aG ainabox "$CURRENT_USER" 2>/dev/null \
        && echo "  [ok] $CURRENT_USER in ainabox" \
        || echo "  [!] usermod ainabox fallito"
fi

for entry in "${USERS[@]}"; do
    IFS=':' read -r uname uid gid home shell <<< "$entry"
    if id "$uname" &>/dev/null; then
        echo "  [ok] utente $uname (già esiste)"
    else
        useradd --system --uid "$uid" --gid "$gid" \
                --home-dir "$home" --shell "$shell" "$uname" 2>/dev/null \
            && echo "  [ok] utente $uname creato" \
            || echo "  [!] utente $uname fallimento"
    fi
done

for entry in "${USERS[@]}"; do
    IFS=':' read -r uname uid gid home shell <<< "$entry"
    if ! grep -q "^${uname}:" /etc/subuid 2>/dev/null; then
        echo "${uname}:100000:65536" >> /etc/subuid
        echo "${uname}:100000:65536" >> /etc/subgid
        echo "  [ok] subuid/subgid $uname"
    fi
done

for entry in "${USERS[@]}"; do
    IFS=':' read -r uname uid gid home shell <<< "$entry"
    rundir="/run/user/$uid"
    [ -d "$home" ] || { mkdir -p "$home" && chown "$uname" "$home" && chmod 750 "$home"; }
    if [ ! -d "$rundir" ]; then
        mkdir -p "$rundir" && chown "$uname" "$rundir" && chmod 700 "$rundir"
        echo "  [ok] $rundir creato"
    fi
done

echo ""
echo "── FASE 2: LUKS + Mount ──"
if [ ! -e /dev/mapper/t7 ]; then
    luks_dev=$(blkid -o device -t UUID="3f39ed9f-cb1a-4509-aa38-37dc994d57a9" 2>/dev/null || true)
    if [ -z "$luks_dev" ]; then
        echo "  [X] Disco T7 non trovato. E collegata?"
        exit 1
    fi
    if [ -f /etc/luks-t7.key ]; then
        cryptsetup luksOpen "$luks_dev" t7 --key-file=/etc/luks-t7.key \
            && echo "  [ok] LUKS t7 aperto (keyfile)." \
            || { echo "  [X] LUKS open FALLITO."; exit 1; }
    else
        cryptsetup luksOpen "$luks_dev" t7 \
            && echo "  [ok] LUKS t7 aperto." \
            || { echo "  [X] LUKS open FALLITO."; exit 1; }
    fi
else
    echo "  [ok] LUKS t7 già aperto."
fi

if mountpoint -q /mnt/Data 2>/dev/null; then
    echo "  [ok] /mnt/Data già montato."
else
    mount /mnt/Data \
        && echo "  [ok] /mnt/Data montato." \
        || { echo "  [X] MOUNT FALLITO."; exit 1; }
fi
sleep 1

echo ""
echo "── FASE 2.5: Linger (enable) ──"
for entry in "${USERS[@]}"; do
    uname="${entry%%:*}"
    loginctl enable-linger "$uname" 2>/dev/null && echo "  [ok] linger $uname acceso." || true
done
echo "── FASE 3: Script + Sudoers ──"
SCRIPTS=("chiudi_tutto" "avvia_servizio.sh" "stato_silo.sh" "apri_chat" "chiudi_chat")
for s in "${SCRIPTS[@]}"; do
    if [ -f "$T7_BIN/$s" ]; then
        install -m 755 "$T7_BIN/$s" "/usr/local/bin/$s"
        echo "  [ok] $s"
    else
        echo "  [!] $s NON in $T7_BIN/"
    fi
done
SUDOERS_FILES=("servizi" "stato_silo" "chat" "apri_ainabox" "disconnetti_ainabox" "vetrina")
for sf in "${SUDOERS_FILES[@]}"; do
    if [ -f "$T7_SUDOERS/$sf" ]; then
        install -m 440 "$T7_SUDOERS/$sf" "/etc/sudoers.d/$sf"
        echo "  [ok] sudoers/$sf"
    else
        echo "  [!] sudoers/$sf NON in $T7_SUDOERS/"
    fi
done

# mano di restituzione — installa la copia host
# icone host — sopravvive a disconnetti (chiave visuale)
APPDIR="/home/$CURRENT_USER/.local/share/applications"
mkdir -p "$APPDIR"
install -m 644 /mnt/Data/engine_zone/desktop/ainabox-apri.desktop "$APPDIR/ainabox-apri.desktop"
install -m 644 /mnt/Data/engine_zone/desktop/ainabox-disconnetti.desktop "$APPDIR/ainabox-disconnetti.desktop"
echo "  [ok] icone host installate"
if [ -f /mnt/Data/engine_zone/disconnetti_ainabox ]; then
    install -m 755 /mnt/Data/engine_zone/disconnetti_ainabox /usr/local/bin/disconnetti_ainabox
    echo "  [ok] disconnetti_ainabox installato su host"
fi
# Vetrina service
T7_SVC="/mnt/Data/engine_zone/vetrina.service"
if [ -f "$T7_SVC" ]; then
    install -m 644 "$T7_SVC" /etc/systemd/system/vetrina.service
    systemctl daemon-reload
    echo "  [ok] vetrina.service installato"
else
    echo "  [!] vetrina.service NON in T7"
fi

echo ""
echo "── FASE 4: Daemon rootless ──"
CONTAINERD_SH="$RUNTIME/containerd-rootless.sh"
RUNTIME_BIN="$RUNTIME/bin"
for entry in "${USERS[@]}"; do
    IFS=':' read -r uname uid gid home shell <<< "$entry"
    rundir="/run/user/$uid"
    sock="$rundir/containerd-rootless/api.sock"
    if [ -S "$sock" ]; then
        echo "  [ok] $uname daemon attivo"
        continue
    fi
    sudo -u "$uname" env \
        XDG_RUNTIME_DIR="$rundir" \
        XDG_DATA_HOME="/mnt/Data/nerdctl_root/$uname" \
        PATH="$RUNTIME_BIN:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
        bash "$CONTAINERD_SH" &
    disown 2>/dev/null
    for i in $(seq 1 5); do
        [ -S "$sock" ] && break
        sleep 1
    done
    if [ -S "$sock" ]; then
        echo "  [ok] $uname daemon avviato"
    else
        echo "  [!] $uname daemon NON avviato"
    fi
done
echo ""
echo "── FASE 4.5: Cintura di rete ──"
CINTURA_DIR="/mnt/Data/network_zone"
if [ -f "$CINTURA_DIR/cintura.aperta.conf" ]; then
    nft delete table inet cintura 2>/dev/null
    if nft -f "$CINTURA_DIR/cintura.aperta.conf" 2>/dev/null && nft -f "$CINTURA_DIR/cintura.peers.conf" 2>/dev/null; then
        echo "  [ok] cintura attiva (profilo aperto)"
    else
        echo "  [!] cintura: fallimento. I servizi restano protetti solo da UFW."
    fi
else
    echo "  [!] cintura: file non trovati in $CINTURA_DIR"
fi

echo ""
echo "── FASE 5: Vetrina ──"
if curl -s -k -o /dev/null --max-time 2 https://127.0.0.1:8765/ 2>/dev/null; then
    echo "  [ok] Vetrina già in ascolto."
else
    systemctl start vetrina
    sleep 5
    if ss -ltnp 2>/dev/null | awk '$4 ~ /:8765$/'; then
        echo "  [ok] Vetrina avviata."
    else
        echo "  [!] Vetrina non ha risposto."
    fi
fi

echo ""
echo "── FASE 6: Browser ──"
if ss -ltnp 2>/dev/null | awk '$4 ~ /:8765$/'; then
    sudo -u "$CURRENT_USER" env \
        DISPLAY=:0 \
        XAUTHORITY="/home/$CURRENT_USER/.Xauthority" \
        firefox -P vetrina https://127.0.0.1:8765 > /dev/null 2>&1 &
    disown 2>/dev/null
    sleep 3
    if pgrep -f "firefox.*vetrina" > /dev/null 2>&1; then
        echo "  [ok] Browser aperto."
    else
        echo "  [!] Browser non si è aperto. Digita: https://127.0.0.1:8765"
    fi
else
    echo "  [!] Vetrina non in ascolto. Digita: https://127.0.0.1:8765"
fi

echo ""
echo "═══════════════════════════════════════════"
echo "  AINABOX accesa. La citta e viva."
echo "═══════════════════════════════════════════"
