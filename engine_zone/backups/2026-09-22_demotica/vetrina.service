[Unit]
Description=Vetrina (AINABOX)
After=network.target

[Service]
User=root
WorkingDirectory=/mnt/Data/vetrina_zone
ExecStart=/mnt/Data/vetrina_zone/venv/bin/python /mnt/Data/vetrina_zone/main.py
Restart=always
RestartSec=5
StandardOutput=append:/mnt/Data/vetrina_zone/vetrina.log
StandardError=append:/mnt/Data/vetrina_zone/vetrina.log

[Install]
WantedBy=multi-user.target
